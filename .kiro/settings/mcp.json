{
  "mcpServers": {
    "product-shot-agent": {
      "command": "C:/Users/PC/Downloads/ads_product_generator/.venv/Scripts/python.exe",
      "args": [
        "mcp_server.py"
      ],
      "env": {
        "GOOGLE_API_KEY": "your_gemini_api_key_here"
      },
      "cwd": "C:/Users/PC/Downloads/ads_product_generator",
